# ==========================================================
# Konfigurasi Storage & Keamanan untuk Deploy di Vercel
# ==========================================================
#
# 1. REKOMENDASI UTAMA (Data Portofolio Instan / Real-time):
#    Hubungkan Upstash Redis lewat Vercel Dashboard -> Storage -> Create Database -> Upstash Redis
#    Vercel akan otomatis mengisi kedua variabel di bawah ini:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 2. REKOMENDASI UTAMA (Upload Gambar / Foto / Logo ke Cloud CDN):
#    Hubungkan Vercel Blob lewat Vercel Dashboard -> Storage -> Create Database -> Blob (Public)
#    Vercel otomatis mengisi BLOB_STORE_ID (OIDC) atau BLOB_READ_WRITE_TOKEN.
#    (Jika hanya menghubungkan Vercel Blob tanpa Upstash Redis, data portofolio juga otomatis tersimpan di Blob!)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# 3. KEAMANAN ADMIN DASHBOARD (/admin) - Sangat disarankan di Production:
#    Isi password bebas agar halaman /admin dan API edit tidak bisa diakses orang lain.
ADMIN_PASSWORD=
